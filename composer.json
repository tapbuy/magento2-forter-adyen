{
    "name": "tapbuy/magento2-forter-adyen",
    "description": "Tapbuy Forter Adyen Integration for Magento 2",
    "type": "magento2-module",
    "version": "1.2.2",
    "license": [
        "OSL-3.0"
    ],
    "require": {
        "php": "^8.1",
        "magento/framework": "^103.0",
        "magento/module-payment": "^100.4",
        "tapbuy/magento2-forter": "^1.2.1",
        "adyen/module-payment": "^8.0 || ^9.0 || ^10.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Tapbuy\\ForterAdyen\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tapbuy\\ForterAdyen\\Test\\": "Test/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    }
}
